# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret. Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string — Project Settings -> Database -> Connection string (URI).
# Used only by `npm run db:schema` to apply supabase/schema.sql. Secret; local only.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key

# Local dev; set to your Vercel URL in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
